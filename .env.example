# Copy to .env for local development only. Never commit a real API key.
# Browser "Model settings" values override these server defaults.

# OpenAI-compatible chat-completions endpoint.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Optional: set true only for a public endpoint that intentionally needs no key.
# LLM_ALLOW_NO_KEY=false
LLM_API_KEY=

# Local only. Render sets PORT automatically.
PORT=3000
